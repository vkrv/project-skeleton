{
  "name": "repo",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint --filter=!@repo/config",
    "typecheck": "turbo run typecheck --filter=!@repo/config",
    "test": "turbo run test --filter=!@repo/config",
    "check:harness": "node scripts/check-harness.mjs",
    "check": "pnpm check:harness && pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "2.10.4",
    "typescript": "6.0.3"
  }
}
